# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to Git — it's in .gitignore
# ─────────────────────────────────────────────

# Your Anthropic API key
# Get one at https://console.anthropic.com
# NOTE: This is fine for local development, but when you add a backend
# server (Express / Next.js), move this key there instead so it's never
# exposed in the browser.
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Future additions ──────────────────────────

# When you add a backend, replace the direct Anthropic calls with your
# own server and add its URL here:
# VITE_API_BASE_URL=http://localhost:3001

# When you add Supabase for auth + database:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
